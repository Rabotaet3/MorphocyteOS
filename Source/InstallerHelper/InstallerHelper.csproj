<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>MorphocyteOS-maintenance</AssemblyName>
    <RuntimeFrameworkVersion>10.0.12</RuntimeFrameworkVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier><SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile><IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Built-in Task Scheduler COM/IDispatch is not trim-compatible; preserve its ABI. -->
    <PublishTrimmed>false</PublishTrimmed>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <DebugType>embedded</DebugType><Version>1.3.0</Version>
    <Product>MorphocyteOS installation maintenance</Product>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../MorphocyteRouter/InstallerMaintenance.cs" Link="InstallerMaintenance.cs" />
    <Compile Include="../MorphocyteRouter/UpdatePackage.cs" Link="UpdatePackage.cs" />
    <Compile Include="../MorphocyteRouter/ReleaseUpdateService.cs" Link="ReleaseUpdateService.cs" />
    <Compile Include="../MorphocyteRouter/BuildInfo.cs" Link="BuildInfo.cs" />
  </ItemGroup>
</Project>
