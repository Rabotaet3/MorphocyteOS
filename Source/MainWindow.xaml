<Window x:Class="MorphocyteRouter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MorphocyteOS Router" Width="1120" Height="760" MinWidth="980" MinHeight="660"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False"
        Background="{DynamicResource ThemeCanvas}" FontFamily="Segoe UI" Icon="Assets/morphocyte.ico" PreviewKeyDown="Window_PreviewKeyDown"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="58" ResizeBorderThickness="8" GlassFrameThickness="0" CornerRadius="23" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource ThemeTooltipBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeTooltipBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="LogSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="36"/><Setter Property="Height" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Track" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeButtonBorder}" BorderThickness="1" CornerRadius="10" Padding="2">
                        <Ellipse x:Name="Knob" Width="14" Height="14" Fill="{DynamicResource ThemeMuted}" HorizontalAlignment="Left"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource ThemeSurfaceSelected}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource ThemeAccent}"/>
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ThemeAccentSoft}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Track" Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="FolderArrowButton" TargetType="Button">
            <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccent}"/><Setter Property="Background" Value="{DynamicResource ThemeExpanderBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeExpanderBorder}"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Content" Value="›"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                        <Border x:Name="ArrowSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                        <Path x:Name="ArrowGlyph" Width="8" Height="8" Stroke="{TemplateBinding Foreground}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M 1,1 L 5,4 L 1,7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" Value="True">
                            <Setter TargetName="ArrowGlyph" Property="Data" Value="M 1,2 L 4,5 L 7,2"/>
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ArrowSurface" Property="Background" Value="{DynamicResource ThemeComboHover}"/><Setter TargetName="ArrowSurface" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="ArrowSurface" Property="Opacity" Value="0.7"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="SidebarToolButton" TargetType="Button">
            <Setter Property="Width" Value="54"/><Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="3,0"/><Setter Property="Foreground" Value="{DynamicResource ThemeAccent}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeButton}"/><Setter Property="BorderBrush" Value="{DynamicResource ThemeButtonBorder}"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ToolSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ToolSurface" Property="Background" Value="{DynamicResource ThemeButtonHover}"/>
                            <Setter TargetName="ToolSurface" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="ToolSurface" Property="Opacity" Value="0.72"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="RuleListItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="4,3"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="ContainerSurface" Background="{DynamicResource ThemeRuleBackground}" BorderBrush="{DynamicResource ThemeRuleBorder}" BorderThickness="1" CornerRadius="12" Padding="1">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ContainerSurface" Property="Background" Value="{DynamicResource ThemeRuleBackground}"/>
                            <Setter TargetName="ContainerSurface" Property="BorderBrush" Value="{DynamicResource ThemeRuleBorder}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ContainerSurface" Property="Background" Value="{DynamicResource ThemeRuleHover}"/>
                            <Setter TargetName="ContainerSurface" Property="BorderBrush" Value="{DynamicResource ThemeRuleHoverBorder}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ContainerSurface" Property="Background" Value="{DynamicResource ThemeRuleSelected}"/>
                            <Setter TargetName="ContainerSurface" Property="BorderBrush" Value="{DynamicResource ThemeRuleSelectedBorder}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True"/><Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ContainerSurface" Property="Background" Value="{DynamicResource ThemeRuleSelectedHover}"/>
                            <Setter TargetName="ContainerSurface" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <DataTemplate x:Key="RuleItemTemplate">
            <Border x:Name="RuleSurface" BorderThickness="1" CornerRadius="10" Padding="13,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="82"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="38"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" PreviewMouseLeftButtonDown="RuleCheck_PreviewMouseLeftButtonDown" Click="RuleEnabled_Click" VerticalAlignment="Center"
                              HorizontalAlignment="Center" ToolTip="Включить или отключить правило и выделенную группу"/>
                    <Border Grid.Column="1" Background="{DynamicResource ThemeTagBackground}" CornerRadius="8" Padding="7,4" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding KindLabel}" Foreground="{DynamicResource ThemeAccent}" FontSize="9" FontWeight="Bold"/>
                    </Border>
                        <TextBlock Grid.Column="2" Text="{Binding Value}" Foreground="{DynamicResource ThemeText}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Border Grid.Column="3" CornerRadius="8" Padding="9,4" Margin="10,0" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource ThemeRouteBackground}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource ThemeRouteBorder}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Route}" Value="DIRECT">
                                        <Setter Property="Background" Value="{DynamicResource ThemeDirectBackground}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource ThemeDirectBorder}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Route}" Value="REJECT">
                                        <Setter Property="Background" Value="{DynamicResource ThemeRejectBackground}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource ThemeRejectBorder}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding RouteLabel}" Foreground="{DynamicResource ThemeText}" FontSize="9" FontWeight="SemiBold"/>
                    </Border>
                    <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="×" Tag="{Binding}" Click="DeleteRule_Click" ToolTip="Удалить правило"/>
                </Grid>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource ThemeSurfaceBorder}"/>
                        <Setter Property="Opacity" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ThemeSurfaceHover}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ThemeSurfaceSelected}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                <Setter Property="Opacity" Value="0.42"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="RuleGroupHeaderTemplate">
            <Border x:Name="FolderDropSurface" Background="{DynamicResource ThemeFolderBackground}" BorderBrush="{DynamicResource ThemeFolderBorder}" BorderThickness="1" CornerRadius="10" Padding="15,7" Margin="4,3" Cursor="SizeAll"
                    ToolTip="Перетащи папку выше или ниже другой папки, чтобы изменить порядок">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="38"/>
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource FolderArrowButton}" Click="FolderToggle_Click" ToolTip="Развернуть или свернуть папку"/>
                    <CheckBox Grid.Column="1" IsThreeState="True" VerticalAlignment="Center" HorizontalAlignment="Center"
                              Loaded="FolderEnabled_Loaded" Click="FolderEnabled_Click" ToolTip="Включить или отключить все правила папки"/>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ThemeText}" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Foreground="{DynamicResource ThemeMuted}" FontSize="9" Margin="0,2,0,0">
                            <Run Text="{Binding ItemCount, Mode=OneWay}"/><Run Text=" правил"/>
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="3" Content="×" Tag="{Binding}" Click="RemoveFolder_Click"
                            ToolTip="Убрать папку — правила останутся и переместятся в общие">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers><DataTrigger Binding="{Binding Name}" Value="ОБЩИЕ ПРАВИЛА"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Border CornerRadius="23" BorderBrush="{DynamicResource ThemeAppOutline}" BorderThickness="1.5" Background="{DynamicResource ThemeCanvas}">
        <Border CornerRadius="21" BorderBrush="{DynamicResource ThemeAppInnerOutline}" BorderThickness="1" Margin="1">
        <Grid ClipToBounds="True">
            <Grid x:Name="WindowContent" ClipToBounds="True" SizeChanged="WindowContent_SizeChanged">
            <Grid.Background>
                <DynamicResource ResourceKey="ThemeBackgroundGradient"/>
            </Grid.Background>

            <Canvas IsHitTestVisible="False" Opacity="0.35">
                <Ellipse Width="380" Height="380" Canvas.Left="820" Canvas.Top="-190" Stroke="{DynamicResource ThemeTitleOutline}" StrokeThickness="1"/>
                <Ellipse Width="280" Height="280" Canvas.Left="870" Canvas.Top="-140" Stroke="{DynamicResource ThemeTitleOutline}" StrokeThickness="1"/>
                <Ellipse Width="52" Height="52" Canvas.Left="1000" Canvas.Top="110" Fill="{DynamicResource ThemeOrbitFill}" Stroke="{DynamicResource ThemeAccent}"/>
                <Ellipse Width="13" Height="13" Canvas.Left="1019" Canvas.Top="129" Fill="{DynamicResource ThemeAccent}"/>
                <Path Stroke="{DynamicResource ThemeOrbitLine}" StrokeThickness="1" Data="M 780,20 C 900,120 810,210 1110,300"/>
                <Path Stroke="{DynamicResource ThemeOrbitLine}" StrokeThickness="1" Data="M 750,0 C 820,150 950,160 1060,360"/>
            </Canvas>

            <Image Source="Assets/morphocyte-icon.png" Width="430" Height="430" HorizontalAlignment="Right"
                   VerticalAlignment="Bottom" Margin="0,0,-120,-145" Opacity="0.045" IsHitTestVisible="False"/>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="58"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="{DynamicResource ThemeTitleBar}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="24,0" VerticalAlignment="Center">
                        <Image Source="Assets/morphocyte-icon.png" Width="38" Height="38" Margin="0,0,12,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Foreground="{DynamicResource ThemeText}" FontWeight="Bold" FontSize="14">
                                <Run Text="МОРФОЦИТ"/><Run Text=" OS" Foreground="{DynamicResource ThemeAccent}"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,12,0">
                        <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource IconButton}" Content="—" Click="Minimize_Click" ToolTip="Свернуть"/>
                        <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource IconButton}" Content="×" Click="Close_Click" ToolTip="Закрыть приложение и остановить ядро"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource ThemeAccentGradient}" Opacity="0.7"/>

                <Grid Grid.Row="1" x:Name="MainBody" Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="WorkspaceRow" Height="*"/>
                        <RowDefinition x:Name="LogSplitterRow" Height="7"/>
                        <RowDefinition x:Name="LogRow" Height="140" MinHeight="70"/>
                    </Grid.RowDefinitions>
                <Grid x:Name="Workspace" Grid.Row="0" Margin="20,6,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="292"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource ThemePanelGradient}" BorderBrush="{DynamicResource ThemePanelBorder}" BorderThickness="1" CornerRadius="18" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="1" Source="Assets/morphocyte-icon.png" Width="52" Height="52" Opacity="0.9" Margin="0,-10,-5,-8"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,13,0,5">
                                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{DynamicResource ThemeStatusNeutral}" Margin="0,0,10,0">
                                        <Ellipse.Effect>
                                            <DropShadowEffect Color="{DynamicResource ThemeAccentGlowColor}" BlurRadius="9" ShadowDepth="0" Opacity="0.7"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <TextBlock x:Name="StatusText" Text="НУЖЕН ПРОФИЛЬ" Foreground="{DynamicResource ThemeText}" FontSize="20" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock x:Name="UptimeText" Text="Выбери своё подключение" Foreground="{DynamicResource ThemeMuted}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Margin="0,23,0,0">
                                <Button x:Name="PowerButton" Style="{StaticResource PrimaryButton}" Height="48" Content="ЗАПУСТИТЬ VPN" Click="PowerButton_Click"/>
                                <Button x:Name="RestartButton" Style="{StaticResource FlatButton}" Height="39" Margin="0,9,0,0" Content="ПЕРЕЗАПУСТИТЬ ЯДРО" Click="RestartButton_Click" IsEnabled="False"/>
                            </StackPanel>

                            <Border Grid.Row="2" Margin="0,22,0,0" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeSurfaceBorder}" BorderThickness="1" CornerRadius="12" Padding="13">
                                <StackPanel>
                                    <TextBlock Text="ТОЧКА ВЫХОДА" Foreground="{DynamicResource ThemeMuted}" FontSize="9" FontWeight="Bold"/>
                                    <TextBlock x:Name="EndpointText" Text="не определена" Foreground="{DynamicResource ThemeAccentSecondary}" FontSize="13" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                                    <Border Height="1" Background="{DynamicResource ThemeSurfaceBorder}" Margin="0,11"/>
                                    <TextBlock Text="ДЕЙСТВИЕ НОВЫХ ПРАВИЛ" Foreground="{DynamicResource ThemeMuted}" FontSize="9" FontWeight="Bold"/>
                                    <ComboBox x:Name="RouteCombo" Margin="0,6,0,0" SelectionChanged="RouteCombo_SelectionChanged"
                                              ToolTip="VPN-маршрут, DIRECT — напрямую, REJECT — блокировать"/>
                                    <TextBlock x:Name="RouteHintText" Text="Выбери действие для добавляемых правил" Foreground="{DynamicResource ThemeRouteHint}" FontSize="9" Margin="2,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="3" VerticalAlignment="Bottom" Margin="0,0,0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource SidebarToolButton}" Click="FaqButton_Click" ToolTip="ЧаВо?">
                                    <TextBlock Text="?" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccent}"/>
                                </Button>
                                <Button Grid.Column="1" Style="{StaticResource SidebarToolButton}" Click="SettingsButton_Click" ToolTip="Настройки">
                                    <TextBlock Text="⚙" FontFamily="Segoe UI Symbol" FontSize="23" Foreground="{DynamicResource ThemeAccent}"/>
                                </Button>
                            </Grid>

                        </Grid>
                    </Border>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Margin="4,8,4,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="МАРШРУТЫ" Foreground="{DynamicResource ThemeText}" FontSize="31" FontWeight="Light"/>
                                <TextBlock Text="Направляй сайты и приложения через VPN, напрямую или в блокировку" Foreground="{DynamicResource ThemeMuted}" FontSize="13" Margin="0,4,12,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="{DynamicResource ThemeTagBackground}" BorderBrush="{DynamicResource ThemeTagBorder}" BorderThickness="1" CornerRadius="16" Padding="13,6" VerticalAlignment="Center">
                                <TextBlock x:Name="CountText" Text="0 ПРАВИЛ" Foreground="{DynamicResource ThemeAccent}" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </Grid>

                        <Border Grid.Row="1" Background="{DynamicResource ThemePanelGradient}" BorderBrush="{DynamicResource ThemePanelBorder}" BorderThickness="1" CornerRadius="15" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="196"/>
                                    <ColumnDefinition Width="116"/>
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <TextBox x:Name="DomainInput" Height="39" KeyDown="DomainInput_KeyDown"
                                             Foreground="{DynamicResource ThemeText}" FontWeight="Medium" ToolTip="Можно вставить домен или полный URL"/>
                                    <TextBlock x:Name="DomainInputHint" Text="Введите сайт или домен" Foreground="{DynamicResource ThemeInputHint}" FontSize="12" Margin="13,0,0,0"
                                               VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=DomainInput}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <ComboBox x:Name="RuleKindCombo" Grid.Column="1" Height="39" Margin="10,0,0,0" SelectedIndex="0" SelectionChanged="RuleKindCombo_SelectionChanged">
                                    <ComboBoxItem Content="Сайт и его поддомены" Tag="DOMAIN-SUFFIX"
                                                  ToolTip="Например, example.com и shop.example.com. Подходит, если нужно охватить весь сайт."/>
                                    <ComboBoxItem Content="Только этот сайт" Tag="DOMAIN"
                                                  ToolTip="Совпадает только example.com. Адрес www.example.com будет отдельным."/>
                                    <ComboBoxItem Content="Адрес содержит слово" Tag="DOMAIN-KEYWORD"
                                                  ToolTip="Например, google совпадёт с google.com и mail.google.com."/>
                                    <ComboBoxItem Content="Всё приложение (.exe)" Tag="PROCESS-NAME"
                                                  ToolTip="Направляет соединения приложения по имени файла, например app.exe."/>
                                </ComboBox>
                                <Button x:Name="AddRuleButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" Height="39" Margin="10,0,0,0" Content="ДОБАВИТЬ" Click="AddRule_Click"/>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2" Margin="0,13,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="190"/>
                            </Grid.ColumnDefinitions>
                            <WrapPanel Margin="0,0,8,0">
                            <Button Style="{StaticResource FlatButton}" Padding="12,6" Content="Выбрать .exe" Click="ChooseProcess_Click"
                                    ToolTip="Выбери .exe: имя процесса появится в поле правила"/>
                            <Button Style="{StaticResource FlatButton}" Padding="12,6" Margin="8,0,0,0" Content="Запущенные процессы" Click="ChooseRunningProcess_Click"
                                    ToolTip="Выбрать приложение, которое уже запущено"/>
                            </WrapPanel>
                            <Grid Grid.Column="1" VerticalAlignment="Top">
                                <TextBox x:Name="SearchBox" Padding="12,7" TextChanged="SearchBox_TextChanged" ToolTip="Поиск по всем маршрутам"/>
                                <TextBlock Text="⌕  Поиск по маршрутам" Foreground="{DynamicResource ThemeInputHint}" FontSize="11" Margin="13,0,0,0"
                                           VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>

                        <Border Grid.Row="3" Background="{DynamicResource ThemeRuleListBackground}" BorderBrush="{DynamicResource ThemeRuleListBorder}" BorderThickness="1" CornerRadius="15" Padding="8">
                            <Grid x:Name="RuleListHost" ClipToBounds="True">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <ListView x:Name="RulesList" Background="{DynamicResource ThemeCanvas}" BorderThickness="0" Foreground="{DynamicResource ThemeText}"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" SelectionMode="Extended"
                                          ItemContainerStyle="{StaticResource RuleListItemStyle}" ItemTemplate="{StaticResource RuleItemTemplate}"
                                          PreviewMouseLeftButtonDown="RulesList_PreviewMouseLeftButtonDown"
                                          PreviewMouseWheel="RulesList_PreviewMouseWheel"
                                          Loaded="RulesList_Loaded" LostMouseCapture="RulesList_LostMouseCapture">
                                    <ListView.GroupStyle>
                                        <GroupStyle HeaderTemplate="{StaticResource RuleGroupHeaderTemplate}">
                                            <GroupStyle.ContainerStyle>
                                                <Style TargetType="GroupItem">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="GroupItem">
                                                                <Expander IsExpanded="True" Loaded="FolderExpander_Loaded" Header="{TemplateBinding Content}" HeaderTemplate="{StaticResource RuleGroupHeaderTemplate}"
                                                                          Background="Transparent" HorizontalContentAlignment="Stretch">
                                                                    <ItemsPresenter/>
                                                                    <Expander.Template>
                                                                        <ControlTemplate TargetType="Expander">
                                                                            <StackPanel>
                                                                                <ContentPresenter x:Name="HeaderSite" ContentSource="Header"/>
                                                                                <ContentPresenter x:Name="ExpandSite" ContentSource="Content" Visibility="Collapsed"/>
                                                                            </StackPanel>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsExpanded" Value="True">
                                                                                    <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Expander.Template>
                                                                </Expander>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </GroupStyle.ContainerStyle>
                                        </GroupStyle>
                                    </ListView.GroupStyle>
                                </ListView>
                                <Canvas x:Name="RuleDragOverlay" IsHitTestVisible="False" Visibility="Collapsed" Panel.ZIndex="10" ClipToBounds="True"/>
                                <StackPanel x:Name="EmptyRulesMessage" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="20">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasItems, ElementName=RulesList}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="◌" Foreground="{DynamicResource ThemeEmptyIcon}" FontSize="36" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Здесь появятся ваши правила" Foreground="{DynamicResource ThemeMuted}" FontSize="12" Margin="0,6,0,0"/>
                                </StackPanel>

                            </Grid>
                        </Border>

                        <Grid Grid.Row="4" Margin="4,14,4,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="UndoButton" Grid.Column="1" Style="{StaticResource FlatButton}" Width="112" Height="44" Margin="0,0,9,0" Content="↶  ОТМЕНИТЬ" Click="UndoDelete_Click" IsEnabled="False" ToolTip="Вернуть последнее удалённое правило"/>
                            <Button x:Name="ApplyButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" Width="190" Height="44" Content="ПРИМЕНИТЬ В YAML" Click="ApplyButton_Click" IsEnabled="False"/>
                        </Grid>
                    </Grid>
                </Grid>
                    <GridSplitter x:Name="LogSplitter" Grid.Row="1" Height="9" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                  Background="Transparent" ShowsPreview="False" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                                  Cursor="SizeNS" ToolTip="Потяни, чтобы изменить высоту журнала">
                        <GridSplitter.Template>
                            <ControlTemplate TargetType="GridSplitter">
                                <Grid Background="Transparent">
                                    <Border Width="52" Height="3" CornerRadius="2" Background="{DynamicResource ThemeSplitter}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border Width="18" Height="3" CornerRadius="2" Background="{DynamicResource ThemeAccent}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.75"/>
                                </Grid>
                            </ControlTemplate>
                        </GridSplitter.Template>
                    </GridSplitter>
                    <Border Grid.Row="2" Margin="20,0,20,14" Background="{DynamicResource ThemeLogPanel}" BorderBrush="{DynamicResource ThemePanelBorder}" BorderThickness="1"
                            CornerRadius="13" Padding="12,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="LogHeader" Margin="2,0,2,6" MinHeight="24" Grid.ColumnSpan="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="ЖУРНАЛ СОБЫТИЙ" Foreground="{DynamicResource ThemeMuted}" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <ToggleButton x:Name="LogVisibilityToggle" Style="{StaticResource LogSwitch}" Margin="10,0,0,0" IsChecked="True" Click="LogVisibilityToggle_Click" ToolTip="Показать или скрыть журнал событий"/>
                                </StackPanel>
                                <Button x:Name="CopyLogButton" Grid.Column="1" Style="{StaticResource FlatButton}" Padding="9,3" Content="КОПИРОВАТЬ" Click="CopyLog_Click"/>
                            </Grid>
                        <TextBox x:Name="LogText" Grid.Row="1" Text="Система готова." IsReadOnly="True" AcceptsReturn="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                                     Background="{DynamicResource ThemeLogBackground}" Foreground="{DynamicResource ThemeLogText}" BorderBrush="{DynamicResource ThemeSurfaceBorder}" BorderThickness="1"
                                     FontFamily="Consolas" FontSize="12" Padding="9,7"/>
                            <Grid x:Name="LogScrollTrack" Grid.Row="1" Grid.Column="1" Width="16" Margin="5,3,0,3"
                                  Background="{DynamicResource ThemeLogTrack}" ClipToBounds="True" Visibility="Collapsed"
                                    SizeChanged="LogScrollTrack_SizeChanged"
                                  MouseLeftButtonDown="LogScrollTrack_MouseLeftButtonDown" PreviewMouseWheel="LogScrollTrack_PreviewMouseWheel"
                                  ToolTip="Перетаскивай ручку для прокрутки журнала">
                                <Border Background="{DynamicResource ThemeLogTrack}" CornerRadius="7"/>
                            <Border x:Name="LogScrollThumb" Height="30" VerticalAlignment="Top" Margin="2"
                                        Background="{DynamicResource ThemeLogThumb}" BorderBrush="{DynamicResource ThemeLogThumbBorder}" BorderThickness="1" CornerRadius="6"
                                        Cursor="SizeNS" RenderTransformOrigin="0.5,0"
                                        MouseLeftButtonDown="LogScrollThumb_MouseLeftButtonDown"
                                        MouseMove="LogScrollThumb_MouseMove" MouseLeftButtonUp="LogScrollThumb_MouseLeftButtonUp"
                                        LostMouseCapture="LogScrollThumb_LostMouseCapture">
                                    <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                                    <Border.Effect><DropShadowEffect Color="{DynamicResource ThemeAccentGlowColor}" BlurRadius="8" ShadowDepth="0" Opacity="0.18"/></Border.Effect>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
                <Border x:Name="DialogShade" Background="{DynamicResource ThemeDialogShade}" Visibility="Collapsed"
                        IsHitTestVisible="True" Panel.ZIndex="1000"/>
            </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
