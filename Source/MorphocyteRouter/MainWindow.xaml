<Window x:Class="MorphocyteRouter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MorphocyteOS Router" Width="1120" Height="760" MinWidth="980" MinHeight="660"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True"
        Background="Transparent" FontFamily="Segoe UI" Icon="Assets/morphocyte.ico" PreviewKeyDown="Window_PreviewKeyDown"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="58" ResizeBorderThickness="8" GlassFrameThickness="0" CornerRadius="23" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="TrayMenuStyle" TargetType="ContextMenu">
            <Setter Property="MinWidth" Value="248"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Margin="5" Padding="7" Background="{DynamicResource ThemeTrayBackground}" BorderBrush="{DynamicResource ThemeAppOutline}" BorderThickness="1" CornerRadius="15">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="TrayMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="MenuSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="9" Padding="13,8">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="MenuSurface" Property="Background" Value="{DynamicResource ThemeSurfaceHover}"/>
                            <Setter TargetName="MenuSurface" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="MenuSurface" Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="TraySeparatorStyle" TargetType="Separator">
            <Setter Property="Margin" Value="11,5"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Background="{DynamicResource ThemeSurfaceBorder}"/></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource ThemeTooltipBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeTooltipBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="FolderArrowButton" TargetType="Button">
            <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccent}"/><Setter Property="Background" Value="{DynamicResource ThemeExpanderBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeExpanderBorder}"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Content" Value="›"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                        <Border x:Name="ArrowSurface" Margin="3" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                        <Path x:Name="ArrowGlyph" Width="8" Height="8" Stroke="{TemplateBinding Foreground}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M 1,1 L 5,4 L 1,7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" Value="True">
                            <Setter TargetName="ArrowGlyph" Property="Data" Value="M 1,2 L 4,5 L 7,2"/>
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ArrowSurface" Property="Background" Value="{DynamicResource ThemeComboHover}"/>
                            <Setter TargetName="ArrowSurface" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="ArrowSurface" Property="Opacity" Value="0.7"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="SidebarToolButton" TargetType="Button">
            <Setter Property="Width" Value="54"/><Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="3,0"/><Setter Property="Foreground" Value="{DynamicResource ThemeAccent}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeButton}"/><Setter Property="BorderBrush" Value="{DynamicResource ThemeButtonBorder}"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ToolSurface" Margin="3" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ToolSurface" Property="Background" Value="{DynamicResource ThemeButtonHover}"/>
                            <Setter TargetName="ToolSurface" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="ToolSurface" Property="Opacity" Value="0.72"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="RuleListItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="4,3"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="ContainerSurface" Background="{DynamicResource ThemeRuleBackground}" BorderBrush="{DynamicResource ThemeRuleBorder}" BorderThickness="1" CornerRadius="12" Padding="1">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ContainerSurface" Property="Background" Value="{DynamicResource ThemeRuleBackground}"/>
                            <Setter TargetName="ContainerSurface" Property="BorderBrush" Value="{DynamicResource ThemeRuleBorder}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ContainerSurface" Property="Background" Value="{DynamicResource ThemeRuleHover}"/>
                            <Setter TargetName="ContainerSurface" Property="BorderBrush" Value="{DynamicResource ThemeRuleHoverBorder}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ContainerSurface" Property="Background" Value="{DynamicResource ThemeRuleSelected}"/>
                            <Setter TargetName="ContainerSurface" Property="BorderBrush" Value="{DynamicResource ThemeRuleSelectedBorder}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True"/><Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ContainerSurface" Property="Background" Value="{DynamicResource ThemeRuleSelectedHover}"/>
                            <Setter TargetName="ContainerSurface" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="RouteMenuStyle" TargetType="ContextMenu">
            <Setter Property="MinWidth" Value="170"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeRouteBorder}" BorderThickness="1" CornerRadius="12" Padding="5">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="RouteMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Option" Background="Transparent" CornerRadius="8" Padding="10,9" Margin="0,1">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="Check" Text="✓" Foreground="{DynamicResource ThemeAccent}" Opacity="0" FontSize="13" VerticalAlignment="Center"/>
                            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" TextElement.Foreground="{DynamicResource ThemeText}" TextElement.FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Option" Property="Background" Value="{DynamicResource ThemeSurfaceHover}"/></Trigger>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Opacity" Value="1"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Option" Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <DataTemplate x:Key="RuleItemTemplate">
            <Border x:Name="RuleSurface" BorderThickness="1" CornerRadius="10" Padding="13,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="82"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="38"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" PreviewMouseLeftButtonDown="RuleCheck_PreviewMouseLeftButtonDown" Click="RuleEnabled_Click" VerticalAlignment="Center"
                              HorizontalAlignment="Center" ToolTip="Включить или отключить правило и выделенную группу"/>
                    <Border Grid.Column="1" Background="{DynamicResource ThemeTagBackground}" CornerRadius="8" Padding="7,4" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding KindLabel}" Foreground="{DynamicResource ThemeAccent}" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="2" Text="{Binding Value}" Foreground="{DynamicResource ThemeText}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="3" Padding="9,5" Margin="10,0" BorderThickness="1" Tag="{Binding}" Click="RuleRoute_Click" ToolTip="Изменить маршрут правила; для выделенных строк — всей группы">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                <Setter Property="Background" Value="{DynamicResource ThemeRouteBackground}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource ThemeRouteBorder}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Route}" Value="DIRECT">
                                        <Setter Property="Background" Value="{DynamicResource ThemeDirectBackground}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource ThemeDirectBorder}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Route}" Value="REJECT">
                                        <Setter Property="Background" Value="{DynamicResource ThemeRejectBackground}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource ThemeRejectBorder}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 1,1 L 5,5 L 9,1" Stroke="{DynamicResource ThemeAccent}" StrokeThickness="1.5" Width="10" Height="6" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding RouteLabel}" Foreground="{DynamicResource ThemeText}" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="×" Tag="{Binding}" Click="DeleteRule_Click" ToolTip="Удалить правило"/>
                </Grid>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource ThemeSurfaceBorder}"/>
                        <Setter Property="Opacity" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ThemeSurfaceHover}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ThemeSurfaceSelected}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding FullTunnelActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                    <Condition Binding="{Binding IsVpnRoute}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Opacity" Value="0.48"/>
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                <Setter Property="Opacity" Value="0.42"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="RuleGroupHeaderTemplate">
            <Border x:Name="FolderDropSurface" Background="{DynamicResource ThemeFolderBackground}" BorderBrush="{DynamicResource ThemeFolderBorder}" BorderThickness="1" CornerRadius="10" Padding="15,7" Margin="4,3" Cursor="SizeAll"
                    ToolTip="Перетащи папку выше или ниже другой папки, чтобы изменить порядок">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="38"/>
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource FolderArrowButton}" Click="FolderToggle_Click" ToolTip="Развернуть или свернуть папку"/>
                    <CheckBox Grid.Column="1" IsThreeState="True" VerticalAlignment="Center" HorizontalAlignment="Center"
                              Loaded="FolderEnabled_Loaded" Click="FolderEnabled_Click" ToolTip="Включить или отключить все правила папки"/>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ThemeText}" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Foreground="{DynamicResource ThemeMuted}" FontSize="9" Margin="0,2,0,0">
                            <Run Text="{Binding ItemCount, Mode=OneWay}"/><Run Text=" правил"/>
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="3" Content="×" Tag="{Binding}" Click="RemoveFolder_Click"
                            ToolTip="Убрать папку — правила останутся и переместятся в общие">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers><DataTrigger Binding="{Binding Name}" Value="ОБЩИЕ ПРАВИЛА"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Border CornerRadius="23" BorderBrush="{DynamicResource ThemeAppOutline}" BorderThickness="1.5" Background="{DynamicResource ThemeCanvas}">
        <Border CornerRadius="21" BorderBrush="{DynamicResource ThemeAppInnerOutline}" BorderThickness="1" Margin="1">
        <Grid x:Name="FrameContent" ClipToBounds="True" SizeChanged="FrameContent_SizeChanged">
            <Grid x:Name="WindowContent" ClipToBounds="True">
            <Grid.Background>
                <DynamicResource ResourceKey="ThemeBackgroundGradient"/>
            </Grid.Background>

            <Canvas IsHitTestVisible="False" Opacity="0.35">
                <Ellipse Width="380" Height="380" Canvas.Left="820" Canvas.Top="-190" Stroke="{DynamicResource ThemeTitleOutline}" StrokeThickness="1"/>
                <Ellipse Width="280" Height="280" Canvas.Left="870" Canvas.Top="-140" Stroke="{DynamicResource ThemeTitleOutline}" StrokeThickness="1"/>
                <Ellipse Width="52" Height="52" Canvas.Left="1000" Canvas.Top="110" Fill="{DynamicResource ThemeOrbitFill}" Stroke="{DynamicResource ThemeAccent}"/>
                <Ellipse Width="13" Height="13" Canvas.Left="1019" Canvas.Top="129" Fill="{DynamicResource ThemeAccent}"/>
                <Path Stroke="{DynamicResource ThemeOrbitLine}" StrokeThickness="1" Data="M 780,20 C 900,120 810,210 1110,300"/>
                <Path Stroke="{DynamicResource ThemeOrbitLine}" StrokeThickness="1" Data="M 750,0 C 820,150 950,160 1060,360"/>
            </Canvas>

            <Image Source="{DynamicResource ThemeLogo}" RenderOptions.BitmapScalingMode="HighQuality" Width="430" Height="430" HorizontalAlignment="Right"
                   VerticalAlignment="Bottom" Margin="0,0,-120,-145" Opacity="0.045" IsHitTestVisible="False"/>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="58"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="{DynamicResource ThemeTitleBar}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="24,0" VerticalAlignment="Center">
                        <Image Source="{DynamicResource ThemeLogo}" RenderOptions.BitmapScalingMode="HighQuality" Width="44" Height="44" Margin="0,0,12,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Foreground="{DynamicResource ThemeText}" FontWeight="Bold" FontSize="14">
                                <Run Text="МОРФОЦИТ"/><Run Text=" OS" Foreground="{DynamicResource ThemeAccent}"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,12,0">
                        <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource IconButton}" Content="—" Click="Minimize_Click" ToolTip="Свернуть"/>
                        <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource IconButton}" Content="×" Click="Close_Click" ToolTip="Свернуть в трей; Выход — в меню значка"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource ThemeAccentGradient}" Opacity="0.7"/>

                <Grid Grid.Row="1" x:Name="MainBody" Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="44"/>
                        <RowDefinition x:Name="WorkspaceRow" Height="*"/>
                    </Grid.RowDefinitions>
                    <Border x:Name="UpdateBanner" Visibility="Collapsed" Background="{DynamicResource ThemeSurfaceSelected}" BorderBrush="{DynamicResource ThemeRouteBorder}" BorderThickness="1" CornerRadius="12" Margin="20,9,20,3" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="UpdateOfferText" Foreground="{DynamicResource ThemeText}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                            <Button x:Name="InstallUpdateButton" Grid.Column="1" Style="{StaticResource FlatButton}" Content="ОБНОВИТЬ" Padding="12,6" Click="DownloadUpdate_Click" ToolTip="Установить обновление и перезапустить приложение; VPN остановится."/>
                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="×" Margin="8,0,0,0" Click="DismissUpdate_Click" ToolTip="Отложить до следующего запуска"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20,5,20,4">
                        <Button x:Name="RoutesTabButton" Style="{StaticResource FlatButton}" Content="МАРШРУТЫ" Padding="17,5" Click="RoutesTab_Click"/>
                        <Button x:Name="JournalTabButton" Style="{StaticResource FlatButton}" Content="ЖУРНАЛ И СОЕДИНЕНИЯ" Margin="8,0,0,0" Padding="17,5" Click="JournalTab_Click"/>
                    </StackPanel>
                <Grid x:Name="Workspace" Grid.Row="2" Margin="20,6,20,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="292"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource ThemePanelGradient}" BorderBrush="{DynamicResource ThemePanelBorder}" BorderThickness="1" CornerRadius="18" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <ScrollViewer x:Name="SidebarScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,5">
                                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{DynamicResource ThemeStatusNeutral}" Margin="0,0,10,0">
                                        <Ellipse.Effect>
                                            <DropShadowEffect Color="{DynamicResource ThemeAccentGlowColor}" BlurRadius="9" ShadowDepth="0" Opacity="0.7"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <TextBlock x:Name="StatusText" Text="НУЖЕН ПРОФИЛЬ" Foreground="{DynamicResource ThemeText}" FontSize="17" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock x:Name="UptimeText" Text="Выбери своё подключение" Foreground="{DynamicResource ThemeMuted}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Margin="0,23,0,0">
                                <Button x:Name="PowerButton" Style="{StaticResource PrimaryButton}" Height="48" Content="ЗАПУСТИТЬ VPN" Click="PowerButton_Click"/>
                                <Button x:Name="RestartButton" Style="{StaticResource FlatButton}" Height="39" Margin="0,9,0,0" Content="ПЕРЕЗАПУСТИТЬ ЯДРО" Click="RestartButton_Click" IsEnabled="False"/>
                            </StackPanel>

                            <Border x:Name="ConnectionCard" Grid.Row="2" Margin="0,22,0,0" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeSurfaceBorder}" BorderThickness="1" CornerRadius="12" Padding="13">
                                <StackPanel>
                                    <TextBlock Text="ПОДКЛЮЧЕНИЕ" Foreground="{DynamicResource ThemeMuted}" FontSize="9" FontWeight="Bold"/>
                                    <TextBlock x:Name="EndpointText" Text="не определена" Foreground="{DynamicResource ThemeAccentSecondary}" FontSize="13" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                                    <Border Height="1" Background="{DynamicResource ThemeSurfaceBorder}" Margin="0,11"/>
                                    <Grid ToolTip="Текущий трафик через ядро, включая прямые маршруты. Это не тест максимальной скорости канала.">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="↓ ПРИЁМ" Foreground="{DynamicResource ThemeMuted}" FontSize="9"/><TextBlock x:Name="DownloadSpeedText" Text="—" Foreground="{DynamicResource ThemeText}" FontSize="18" Margin="0,4,0,0"/></StackPanel>
                                        <StackPanel Grid.Column="1"><TextBlock Text="↑ ОТДАЧА" Foreground="{DynamicResource ThemeMuted}" FontSize="9"/><TextBlock x:Name="UploadSpeedText" Text="—" Foreground="{DynamicResource ThemeText}" FontSize="18" Margin="0,4,0,0"/></StackPanel>
                                    </Grid>
                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel ToolTip="Задержка HTTPS-запроса через VPN; проверка каждые 20 секунд, пока окно открыто."><TextBlock Text="ПИНГ" Foreground="{DynamicResource ThemeMuted}" FontSize="9"/><TextBlock x:Name="PingText" Text="—" Foreground="{DynamicResource ThemeText}" FontSize="18" Margin="0,4,0,0"/></StackPanel>
                                        <StackPanel Grid.Column="1"><TextBlock Text="ЗАГРУЗКА ↓" Foreground="{DynamicResource ThemeMuted}" FontSize="9"/><TextBlock x:Name="StabilityText" Text="—" Foreground="{DynamicResource ThemeText}" FontSize="18" Margin="0,4,0,0"/></StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="ConnectionStateText" Text="Проверка не выполнялась" Foreground="{DynamicResource ThemeText}" FontSize="11" Margin="0,11,0,0" TextWrapping="Wrap"/>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Button x:Name="CheckConnectionButton" Style="{StaticResource FlatButton}" Content="ПРОВЕРИТЬ VPN" Padding="4,7" FontSize="10" Click="CheckConnection_Click"/>
                                        <Button x:Name="SpeedTestButton" Grid.Column="2" Style="{StaticResource FlatButton}" Content="СКОРОСТЬ" Padding="4,7" FontSize="10" Click="SpeedTest_Click" ToolTip="Замер скорости через VPN: тестовая загрузка до 64 МБ, не более 15 секунд. Можно остановить повторным нажатием."/>
                                    </Grid>
                                    <TextBlock x:Name="LastIssueText" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Foreground="{DynamicResource ThemeAccentSecondary}" FontSize="10" Margin="0,8,0,0" MaxHeight="44" TextWrapping="Wrap" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Grid>
                        </ScrollViewer>
                            <Border Grid.Row="1" Margin="0,12,0,0" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeSurfaceBorder}" BorderThickness="1" CornerRadius="12" Padding="13">
                                <CheckBox x:Name="FullTunnelCheck" Click="FullTunnel_Click" Cursor="Hand" Focusable="True">
                                    <CheckBox.Template>
                                        <ControlTemplate TargetType="CheckBox">
                                            <Grid Background="Transparent" MinHeight="22">
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="TUN" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" VerticalAlignment="Center"/>
                                                <Grid Grid.Column="1" Width="42" Height="22">
                                                    <Border x:Name="ToggleTrack" CornerRadius="11" Background="{DynamicResource ThemeSurfaceSelected}" BorderBrush="{DynamicResource ThemeSurfaceBorder}" BorderThickness="1"/>
                                                    <Ellipse x:Name="ToggleThumb" Width="16" Height="16" HorizontalAlignment="Left" Margin="3,0,0,0" Fill="{DynamicResource ThemeMuted}">
                                                        <Ellipse.RenderTransform><TranslateTransform X="0"/></Ellipse.RenderTransform>
                                                    </Ellipse>
                                                </Grid>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="ToggleTrack" Property="Background" Value="{DynamicResource ThemeSurfaceActive}"/>
                                                    <Setter TargetName="ToggleTrack" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                                                    <Setter TargetName="ToggleThumb" Property="Fill" Value="{DynamicResource ThemeAccent}"/>
                                                    <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ToggleThumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="20" Duration="0:0:0.12"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions>
                                                    <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ToggleThumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.12"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleTrack" Property="BorderBrush" Value="{DynamicResource ThemeAccentSecondary}"/></Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ToggleTrack" Property="BorderBrush" Value="{DynamicResource ThemeAccentSecondary}"/></Trigger>
                                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </CheckBox.Template>
                                </CheckBox>
                            </Border>
                            <Grid x:Name="SidebarTools" Grid.Row="2" VerticalAlignment="Bottom" Margin="0,14,0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource SidebarToolButton}" Click="FaqButton_Click" ToolTip="ЧаВо?">
                                    <TextBlock Text="?" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccent}"/>
                                </Button>
                                <Button Grid.Column="1" Style="{StaticResource SidebarToolButton}" Click="SettingsButton_Click" ToolTip="Настройки">
                                    <TextBlock Text="⚙" FontFamily="Segoe UI Symbol" FontSize="23" Foreground="{DynamicResource ThemeAccent}"/>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="2">
                    <Grid x:Name="RoutesPage">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="МАРШРУТЫ" Foreground="{DynamicResource ThemeText}" FontSize="31" FontWeight="Light" Margin="4,8,4,15"/>

                        <Border Grid.Row="1" Background="{DynamicResource ThemePanelGradient}" BorderBrush="{DynamicResource ThemePanelBorder}" BorderThickness="1" CornerRadius="15" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="116"/>
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <TextBox x:Name="DomainInput" Height="39" KeyDown="DomainInput_KeyDown"
                                             Foreground="{DynamicResource ThemeText}" FontWeight="Medium" ToolTip="Можно вставить домен или полный URL"/>
                                    <TextBlock x:Name="DomainInputHint" Text="Введите сайт или домен" Foreground="{DynamicResource ThemeInputHint}" FontSize="12" Margin="13,0,0,0"
                                               VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=DomainInput}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <ComboBox x:Name="RuleKindCombo" Grid.Column="1" Height="39" Margin="10,0,0,0" SelectedIndex="0" SelectionChanged="RuleKindCombo_SelectionChanged">
                                    <ComboBoxItem Content="Весь домен" Tag="DOMAIN-SUFFIX"/>
                                    <ComboBoxItem Content="Точное имя" Tag="DOMAIN"/>
                                    <ComboBoxItem Content="По слову" Tag="DOMAIN-KEYWORD"/>
                                    <ComboBoxItem Content="Процесс .exe" Tag="PROCESS-NAME"/>
                                </ComboBox>
                                <Button x:Name="AddRuleButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" Height="39" Margin="10,0,0,0" Content="ДОБАВИТЬ" Click="AddRule_Click"/>
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="Новое правило:" Foreground="{DynamicResource ThemeMuted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ComboBox x:Name="RouteCombo" Width="160" Height="32" SelectionChanged="RouteCombo_SelectionChanged">
                                        <ComboBoxItem Content="VPN" Tag="VPN"/>
                                        <ComboBoxItem Content="Напрямую" Tag="DIRECT"/>
                                        <ComboBoxItem Content="Блокировать" Tag="REJECT"/>
                                    </ComboBox>
                                    <TextBlock x:Name="RouteHintText" Text="Для новых записей" Foreground="{DynamicResource ThemeMuted}" FontSize="10" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2" Margin="0,13,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="190"/>
                            </Grid.ColumnDefinitions>
                            <WrapPanel Margin="0,0,8,0">
                            <Button Style="{StaticResource FlatButton}" Padding="12,6" Content="Выбрать .exe" Click="ChooseProcess_Click"
                                    ToolTip="Выбери .exe: имя процесса появится в поле правила"/>
                            <Button Style="{StaticResource FlatButton}" Padding="12,6" Margin="8,0,0,0" Content="Запущенные процессы" Click="ChooseRunningProcess_Click"
                                    ToolTip="Выбрать приложение, которое уже запущено"/>
                            </WrapPanel>
                            <Grid Grid.Column="1" VerticalAlignment="Top">
                                <TextBox x:Name="SearchBox" Padding="12,7" TextChanged="SearchBox_TextChanged" ToolTip="Поиск по всем маршрутам"/>
                                <TextBlock Text="⌕  Поиск по маршрутам" Foreground="{DynamicResource ThemeInputHint}" FontSize="11" Margin="13,0,0,0"
                                           VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>

                        <Border Grid.Row="3" Background="{DynamicResource ThemeRuleListBackground}" BorderBrush="{DynamicResource ThemeRuleListBorder}" BorderThickness="1" CornerRadius="15" Padding="8">
                            <Grid x:Name="RuleListHost" ClipToBounds="True">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                                                <ListView x:Name="RulesList" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ThemeText}"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" SelectionMode="Extended"
                                          ItemContainerStyle="{StaticResource RuleListItemStyle}" ItemTemplate="{StaticResource RuleItemTemplate}"
                                          PreviewMouseLeftButtonDown="RulesList_PreviewMouseLeftButtonDown"
                                          PreviewMouseWheel="RulesList_PreviewMouseWheel"
                                          Loaded="RulesList_Loaded" LostMouseCapture="RulesList_LostMouseCapture">
                                    <ListView.GroupStyle>
                                        <GroupStyle HeaderTemplate="{StaticResource RuleGroupHeaderTemplate}">
                                            <GroupStyle.ContainerStyle>
                                                <Style TargetType="GroupItem">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="GroupItem">
                                                                <Expander IsExpanded="True" Loaded="FolderExpander_Loaded" Header="{TemplateBinding Content}" HeaderTemplate="{StaticResource RuleGroupHeaderTemplate}"
                                                                          Background="Transparent" HorizontalContentAlignment="Stretch">
                                                                    <ItemsPresenter/>
                                                                    <Expander.Template>
                                                                        <ControlTemplate TargetType="Expander">
                                                                            <StackPanel>
                                                                                <ContentPresenter x:Name="HeaderSite" ContentSource="Header"/>
                                                                                <ContentPresenter x:Name="ExpandSite" ContentSource="Content" Visibility="Collapsed" Opacity="0">
                                                                                    <ContentPresenter.RenderTransform><TranslateTransform Y="-5"/></ContentPresenter.RenderTransform>
                                                                                </ContentPresenter>
                                                                            </StackPanel>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsExpanded" Value="True">
                                                                                    <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                                                                                    <Trigger.EnterActions>
                                                                                        <BeginStoryboard>
                                                                                            <Storyboard>
                                                                                                <DoubleAnimation Storyboard.TargetName="ExpandSite" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.19"/>
                                                                                                <DoubleAnimation Storyboard.TargetName="ExpandSite" Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" From="-5" To="0" Duration="0:0:0.19"/>
                                                                                            </Storyboard>
                                                                                        </BeginStoryboard>
                                                                                    </Trigger.EnterActions>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Expander.Template>
                                                                </Expander>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </GroupStyle.ContainerStyle>
                                        </GroupStyle>
                                    </ListView.GroupStyle>
                                </ListView>
                                <Canvas x:Name="RuleDragOverlay" IsHitTestVisible="False" Visibility="Collapsed" Panel.ZIndex="10" ClipToBounds="True"/>
                                <StackPanel x:Name="EmptyRulesMessage" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="20">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasItems, ElementName=RulesList}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="◌" Foreground="{DynamicResource ThemeEmptyIcon}" FontSize="36" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Здесь появятся ваши правила" Foreground="{DynamicResource ThemeMuted}" FontSize="12" Margin="0,6,0,0"/>
                                </StackPanel>

                            </Grid>
                        </Border>

                        <Grid Grid.Row="4" Margin="4,14,4,2">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ChangesSummaryText" Grid.Row="0" Grid.ColumnSpan="3" FontSize="10" Foreground="{DynamicResource ThemeMuted}" TextWrapping="Wrap" Margin="0,0,0,7" Visibility="Collapsed"/>
                            <Button x:Name="RedoRulesButton" Grid.Row="1" Grid.Column="0" Style="{StaticResource FlatButton}" Width="44" Height="44" Padding="0" HorizontalAlignment="Right" Margin="0,0,9,0" AutomationProperties.Name="Повторить изменение" ToolTip="Повторить изменение · Ctrl+Y" Click="RedoRules_Click" IsEnabled="False">
                                <Path Width="16" Height="16" Stretch="Uniform" Data="M 16,6 L 9,6 C 4,6 2,8 2,11 C 2,14 4,16 8,16 L 10,16 M 16,6 L 12,2 M 16,6 L 12,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Button>
                            <Button x:Name="UndoButton" Grid.Row="1" Grid.Column="1" Style="{StaticResource FlatButton}" MinWidth="112" Height="44" Padding="12,5" Margin="0,0,9,0" AutomationProperties.Name="Отменить изменение" Click="UndoDelete_Click" IsEnabled="False" ToolTip="Отменить изменение правил · Ctrl+Z">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center" Stretch="Uniform" Data="M 2,6 L 9,6 C 14,6 16,8 16,11 C 16,14 14,16 10,16 L 8,16 M 2,6 L 6,2 M 2,6 L 6,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    <TextBlock Text="ОТМЕНИТЬ" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ApplyButton" Grid.Row="1" Grid.Column="2" Style="{StaticResource PrimaryButton}" MinWidth="190" Height="44" Content="ПРИМЕНИТЬ В YAML" Click="ApplyButton_Click" IsEnabled="False"/>
                        </Grid>
                    </Grid>
                    <Border x:Name="JournalPage" Visibility="Collapsed" Background="{DynamicResource ThemeLogPanel}" BorderBrush="{DynamicResource ThemePanelBorder}" BorderThickness="1" CornerRadius="15" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="3*"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="ЖУРНАЛ И СОЕДИНЕНИЯ" FontSize="23" FontWeight="Light" Foreground="{DynamicResource ThemeText}"/>
                                <WrapPanel Margin="0,9,0,0">
                                    <Button x:Name="RunDiagnosticButton" Style="{StaticResource FlatButton}" Content="ПРОВЕРИТЬ ПОДКЛЮЧЕНИЕ" Padding="10,5" Margin="0,0,8,5" Click="RunDiagnostic_Click"/>
                                </WrapPanel>
                            </StackPanel>
                            <Grid Grid.Row="1" Margin="0,10,0,9">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="ConnectionSearchBox" ToolTip="Фильтр: процесс, адрес, правило или маршрут" TextChanged="ConnectionSearch_TextChanged" Padding="9,6"/>
                                <Button x:Name="RefreshConnectionsButton" Grid.Column="1" Style="{StaticResource FlatButton}" Content="ОБНОВИТЬ" Padding="12,6" Margin="8,0,0,0" Click="RefreshConnections_Click"/>
                            </Grid>
                            <Border Grid.Row="2" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource ThemeSurfaceBorder}" Background="{DynamicResource ThemeSurface}" Padding="1">
                            <DataGrid x:Name="ConnectionsGrid" SizeChanged="ConnectionsGrid_SizeChanged" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="38" ColumnHeaderHeight="40" BorderThickness="0" SelectionUnit="FullRow" Background="{DynamicResource ThemeSurface}" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeSurfaceBorder}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <DataGrid.Resources>
                                    <Style x:Key="ConnectionHeaderGrip" TargetType="Thumb">
                                        <Setter Property="Width" Value="5"/><Setter Property="Cursor" Value="SizeWE"/>
                                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
                                    </Style>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="{DynamicResource ThemeTagBackground}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="12"/>
                                        <Setter Property="Padding" Value="8,6"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template"><Setter.Value>
                                            <ControlTemplate TargetType="DataGridColumnHeader">
                                                <Grid>
                                                    <Border x:Name="HeaderSurface" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource ThemeSurfaceBorder}" BorderThickness="0,0,1,1">
                                                        <Grid Margin="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                                                            <Path x:Name="SortGlyph" Data="M 0,4 L 3,0 L 6,4" Stroke="{DynamicResource ThemeAccent}" StrokeThickness="1.4" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
                                                        </Grid>
                                                    </Border>
                                                    <Thumb x:Name="PART_LeftHeaderGripper" Style="{StaticResource ConnectionHeaderGrip}" HorizontalAlignment="Left"/>
                                                    <Thumb x:Name="PART_RightHeaderGripper" Style="{StaticResource ConnectionHeaderGrip}" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource ThemeSurfaceActive}"/></Trigger>
                                                    <Trigger Property="SortDirection" Value="Ascending"><Setter TargetName="SortGlyph" Property="Visibility" Value="Visible"/></Trigger>
                                                    <Trigger Property="SortDirection" Value="Descending"><Setter TargetName="SortGlyph" Property="Visibility" Value="Visible"/><Setter TargetName="SortGlyph" Property="Data" Value="M 0,0 L 3,4 L 6,0"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value></Setter>
                                    </Style>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template"><Setter.Value>
                                            <ControlTemplate TargetType="DataGridRow">
                                                <Grid>
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="7" Margin="1"/>
                                                    <DataGridCellsPresenter Margin="0,1"/>
                                                    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Margin="1" IsHitTestVisible="False"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value></Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ThemeSurfaceHover}"/></Trigger>
                                            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource ThemeSurfaceSelected}"/><Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/></Trigger>
                                        </Style.Triggers>
                                    </Style>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Padding" Value="9,4"/><Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template"><Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}"><ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/></Border></ControlTemplate>
                                        </Setter.Value></Setter>
                                    </Style>
                                    <Style x:Key="ConnectionCellTextStyle" TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/></Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Приложение" Binding="{Binding Process}" ElementStyle="{StaticResource ConnectionCellTextStyle}" Width="130" MinWidth="95"/>
                                    <DataGridTextColumn Header="Адрес" Binding="{Binding Destination}" ElementStyle="{StaticResource ConnectionCellTextStyle}" Width="*" MinWidth="130"/>
                                    <DataGridTextColumn Header="Протокол" Binding="{Binding Network}" ElementStyle="{StaticResource ConnectionCellTextStyle}" Width="85"/>
                                    <DataGridTextColumn Header="Правило" Binding="{Binding Rule}" ElementStyle="{StaticResource ConnectionCellTextStyle}" Width="150" MinWidth="95"/>
                                    <DataGridTextColumn Header="Маршрут" Binding="{Binding Route}" ElementStyle="{StaticResource ConnectionCellTextStyle}" Width="140" MinWidth="95"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            </Border>
                            <Grid Grid.Row="3" Margin="0,11,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="ConnectionsStatusText" Text="Соединения появятся после запуска VPN. Короткие запросы могут завершиться между обновлениями." FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource ThemeMuted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Button x:Name="CopyLogButton" Grid.Column="1" Style="{StaticResource FlatButton}" Content="КОПИРОВАТЬ ЖУРНАЛ" Padding="10,5" Click="CopyLog_Click"/>
                            </Grid>
                            <TextBox x:Name="LogText" Grid.Row="4" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource ThemeLogBackground}" Foreground="{DynamicResource ThemeLogText}" BorderBrush="{DynamicResource ThemeSurfaceBorder}" FontFamily="Consolas" FontSize="11" Padding="9,7"/>
                        </Grid>
                    </Border>
                    </Grid>
                </Grid>
                </Grid>
            </Grid>
                <Border x:Name="DialogShade" Background="{DynamicResource ThemeDialogShade}" Visibility="Collapsed"
                        IsHitTestVisible="True" Panel.ZIndex="1000"/>
            </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
